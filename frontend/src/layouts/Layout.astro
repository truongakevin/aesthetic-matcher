---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Discover and match aesthetic styles from your images with machine learning.',
} = Astro.props;
const siteName = 'Aesthetic Matcher';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalPath = Astro.url.pathname === '/'
	? '/'
	: `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImageUrl = new URL('/favicon.ico', Astro.site);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: siteName,
	operatingSystem: 'All',
	applicationCategory: 'PhotographyApplication',
	url: new URL('/', Astro.site).href,
	description,
	offers: {
		'@type': 'Offer',
		price: '0.00',
		priceCurrency: 'USD',
	},
	creator: {
		'@type': 'Person',
		name: 'Kevin Truong',
	},
};

---

<!doctype html>
<html lang="en">
    <head>
		<!-- SEO -->
        <title>{pageTitle}</title>
        <meta name="generator" content={Astro.generator} />
		<meta charset="UTF-8" />
		<meta name="description" content={description}>
		<meta name="keywords" content="aesthetic matcher, aesthetic matching, aesthetic match, match aesthetic, aesthetic identifier, identify aesthetic, aesthetic recognition, aesthetic finder, discover aesthetics, aesthetic from image, aesthetic styles, image analysis, machine learning, image upload">
		<meta name="author" content="Kevin Truong">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="canonical" href={canonicalUrl}>
		<link rel="icon" href="/favicon.ico" type="image/x-icon">

		<meta property="og:type" content="website">
		<meta property="og:site_name" content={siteName}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={socialImageUrl}>
		<meta property="og:url" content={canonicalUrl}>
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={socialImageUrl}>
		
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-H4K2SRXVPV"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-H4K2SRXVPV');
		</script>

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Rowdies:wght@300;400;700&family=Sixtyfour+Convergence&display=swap" rel="stylesheet">
	</head>
    <body>
		<main>
			<slot />
		</main>
    </body>
</html>
<style is:global>
	:root {
		--primary: #d998d9;
		--secondary: #f5d6f5;
		--ternary: #cfabd2;
		--text: #F2EFEA;
		--background: #161616;
	}
	html {
		font-family: Rowdies;
		font-size: 32px;
		letter-spacing: -.02em;
		background-color: var(--background);
		margin: 0;
		height: 100%;
	}
	
	body {
		margin: 0;
		height: 100%;
		text-align: center;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	body::-webkit-scrollbar {
		display: none;
	}
	a {
		text-decoration: none;
	}
	h1 {
		margin: 75px 0 25px;
		color: var(--primary);
		line-height: .8;
		letter-spacing: -.05em;
	}
	
	main {
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	@media screen and (max-width: 768px){
	}
</style>
